# Copy this file to .env and fill in your own Supabase project credentials.
# Find these under Supabase Dashboard -> Project Settings -> API.
#
# The app works perfectly well with these left blank — it just runs on local
# mock data instead of your live database. Add them whenever you're ready.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
